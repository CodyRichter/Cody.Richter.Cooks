# API Configuration
# Override the default API base URL if needed
# Default: http://localhost:8000 for development
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Environment
NODE_ENV=development

# Cloudflare Turnstile site key (registration and forgot-password captcha)
# Default is Cloudflare's always-pass test key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
