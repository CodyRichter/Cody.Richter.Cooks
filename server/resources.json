{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "RecipeTable": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "TableName": "RecipeTable",
        "AttributeDefinitions": [
          {
            "AttributeName": "name",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "name",
            "KeyType": "HASH"
          }
        ],
        "ProvisionedThroughput": {
          "ReadCapacityUnits": "5",
          "WriteCapacityUnits": "5"
        }
      }
    },
    "CodyRichterCooksLambdaRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": ["lambda.amazonaws.com", "edgelambda.amazonaws.com"]
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Path": "/",
        "Policies": [
          {
            "PolicyName": "LambdaDynamoDBAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:DeleteItem",
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:Query",
                    "dynamodb:Scan"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": ["s3:GetObject", "s3:PutObject", "s3:ListBucket"],
                  "Resource": [
                    "arn:aws:s3:::cody-richter-cooks-lambda-functions",
                    "arn:aws:s3:::cody-richter-cooks-lambda-functions/*"
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogGroup",
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": ["lambda:InvokeFunction"],
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    },
    "CreateRecipeLambda": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Handler": "lambdas.handlers.create_recipe.lambda_handler",
        "Role": {
          "Fn::GetAtt": ["CodyRichterCooksLambdaRole", "Arn"]
        },
        "Code": {
          "S3Bucket": "cody-richter-cooks-lambda-functions",
          "S3Key": "createRecipeLambda.zip"
        },
        "Runtime": "python3.9",
        "Timeout": 10
      }
    }
  }
}
