# Application Configuration
APP_NAME=Cody Richter Cooks API
APP_VERSION=1.0.0
DEBUG=true

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/recipes

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Security Configuration
# CRITICAL: SECRET_KEY is REQUIRED and must be cryptographically secure
# The application will fail to start without a valid SECRET_KEY
# Minimum length: 32 characters (recommended: 64 characters for 256-bit security)
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER commit your actual SECRET_KEY to version control!
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Security Configuration
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGITS=true
PASSWORD_REQUIRE_SPECIAL=true
