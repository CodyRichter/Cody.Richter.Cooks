# Application Configuration
APP_NAME=Cody Richter Cooks API
APP_VERSION=1.0.0
DEBUG=true

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/recipes

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Security Configuration
# IMPORTANT: Generate a secure secret key and set it in your .env file
# Run: python -c "import secrets; print(secrets.token_hex(32))"
# Never use the default value in production!
SECRET_KEY=your-secret-key-change-in-production-use-256-bit-hex-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Security Configuration
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGITS=true
PASSWORD_REQUIRE_SPECIAL=true
